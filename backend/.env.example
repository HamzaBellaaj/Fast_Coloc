# Fill in backend/.env.local; ignored by Git. Never use Immovia credentials.
# Spring does NOT automatically load a .env file.
FASTCOLOC_JDBC_URL=jdbc:postgresql://aws-1-eu-north-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=config/supabase-prod-ca.crt&currentSchema=fastcoloc
FASTCOLOC_DB_USERNAME=fastcoloc_backend.nklsbubnyznlfpxpxsrp
FASTCOLOC_DB_PASSWORD=
# JDBC URL from FastColoc's Connect panel, SSL required. Prefer direct/session pooler for long-lived Spring.
# Example shape only: jdbc:postgresql://HOST:5432/postgres?sslmode=verify-full&sslrootcert=C:/path/ca.crt&currentSchema=fastcoloc
# Direct connection or session pooler. If the pooler requires a project suffix in the login,
# use fastcoloc_backend.nklsbubnyznlfpxpxsrp (database current_user remains fastcoloc_backend).
# Obtain host/port and CA from FastColoc's Connect panel. Never reuse Immovia credentials.
# Public FastColoc key retrieved via MCP; not a server secret. Override on rotation.
FASTCOLOC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YTqpG2K1q_8EFCMRD2lkkA_BenxY_CF
FASTCOLOC_FRONTEND_ORIGIN=http://localhost:4200
SERVER_PORT=8001
# Backend-only secret API key; never copy to Angular, Android or Postman.
FASTCOLOC_SUPABASE_SECRET_KEY=
FASTCOLOC_AUTH_CALLBACK_URL=http://localhost:4200/auth/callback
# Optional operator tools only; not used by Spring's datasource.
FASTCOLOC_DB_ADMIN_PASSWORD=
FASTCOLOC_BOOTSTRAP_ADMIN_EMAIL=
# Optional Management API configuration (separate from the Auth server key).
FASTCOLOC_MANAGEMENT_ACCESS_TOKEN=
FASTCOLOC_GOOGLE_CLIENT_ID=
FASTCOLOC_GOOGLE_CLIENT_SECRET=

# Business notifications (local n8n setup; never put a real token in this template).
FASTCOLOC_NOTIFICATIONS_ENABLED=false
FASTCOLOC_NOTIFICATION_WEBHOOK_URL=http://localhost:32768/webhook/fastcoloc-notifications
FASTCOLOC_NOTIFICATION_WEBHOOK_TOKEN=
FASTCOLOC_NOTIFICATION_MODE=local

# PayPal Checkout uses Sandbox by default.
APP_FRONTEND_URL=http://localhost:4200
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
