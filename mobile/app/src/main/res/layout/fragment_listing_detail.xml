<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvTitle" android:text="@string/s2_tvTitle" android:textAppearance="@style/TextAppearance.FastColoc.Title" android:layout_marginTop="12dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPhotos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="24dp" android:clipToPadding="false" android:nestedScrollingEnabled="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvRent" android:textColor="@color/fc_text" android:textSize="23sp" android:textStyle="bold" android:text="@string/s2_tvRent" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvState" android:accessibilityLiveRegion="polite" android:textSize="12sp" android:text="@string/s2_tvState" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp" />
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnRefreshListing" android:text="@string/s2_btnRefreshListing" android:minHeight="48dp" android:layout_marginTop="8dp" style="@style/Widget.FastColoc.Button.Outlined" />
        <com.iset.fastcolloc.ui.HousingSkeletonView android:id="@+id/housingSkeleton" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginVertical="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="À propos de cette annonce" android:textAppearance="@style/TextAppearance.FastColoc.Section" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvDescription" android:text="@string/s2_tvDescription" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvPlace" android:text="@string/s2_tvPlace" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvInfo" android:text="@string/s2_tvInfo" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="24dp" android:background="@color/fc_line" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Les équipements et disponibilités" android:textAppearance="@style/TextAppearance.FastColoc.Section" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvEquipment" android:text="@string/s2_tvEquipment" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvAvailable" android:text="@string/s2_tvAvailable" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvExpiry" android:text="@string/s2_tvExpiry" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnContact" style="@style/Widget.FastColoc.Button" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/messages_contact" />
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnFavorite" android:text="@string/s2_btnFavorite" android:minHeight="48dp" android:layout_marginTop="8dp" style="@style/Widget.FastColoc.Button.Outlined" />
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnEditListing" android:text="@string/s2_btnEditListing" android:minHeight="48dp" android:layout_marginTop="8dp" style="@style/Widget.FastColoc.Button.Outlined" />
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnRenewListing" android:text="@string/s2_btnRenewListing" android:minHeight="48dp" android:layout_marginTop="8dp" style="@style/Widget.FastColoc.Button.Outlined" />
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnDeleteListing" android:text="@string/s2_btnDeleteListing" android:minHeight="48dp" android:layout_marginTop="8dp" style="@style/Widget.FastColoc.Button.Outlined" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>