<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/fc_page">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_fc_note">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recommendations_title" android:textAppearance="@style/TextAppearance.FastColoc.Title" android:textSize="32sp" android:textColor="@color/fc_link" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recommendations_intro" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="8dp" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnRefreshRecommendations" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recommendations_refresh" android:layout_marginTop="12dp" style="@style/Widget.FastColoc.Button.Outlined" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/recommendationProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
    <TextView android:id="@+id/tvRecommendationHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recommendations_profile_hint" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnCompleteRecommendationProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recommendations_complete_profile" android:visibility="gone" style="@style/Widget.FastColoc.Button.Outlined" />
    <TextView android:id="@+id/tvRecommendationState" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:accessibilityLiveRegion="polite" android:layout_marginVertical="12dp" />
    <com.iset.fastcolloc.ui.HousingSkeletonView android:id="@+id/housingSkeleton" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginVertical="16dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRecommendations" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" />
</LinearLayout>