<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@android:color/transparent" android:padding="0dp" android:layout_marginBottom="16dp">
    <com.google.android.material.imageview.ShapeableImageView app:shapeAppearanceOverlay="@style/ShapeAppearance.FastColoc.Photo" android:id="@+id/ivPhoto" android:layout_width="match_parent" android:layout_height="250dp" android:scaleType="centerCrop" android:background="@color/fc_surface_alt" android:contentDescription="@string/s2_photo" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvTitle" android:textSize="17sp" android:maxLines="2" android:ellipsize="end" android:text="@string/s2_tvTitle" android:textAppearance="@style/TextAppearance.FastColoc.Title" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvPlace" android:text="@string/s2_tvPlace" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="8dp" android:textColor="@color/fc_muted" android:textSize="14sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvRent" android:textColor="@color/fc_text" android:textSize="20sp" android:textStyle="bold" android:text="@string/s2_tvRent" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvInfo" android:text="@string/s2_tvInfo" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvStatus" android:text="@string/s2_tvStatus" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="8dp" />
    <LinearLayout android:id="@+id/recommendationMatch" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:layout_marginTop="8dp" android:background="@drawable/bg_fc_note" android:visibility="gone">
        <TextView android:id="@+id/tvRecommendationScore" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/fc_link" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recommendations_match_label" android:textAppearance="@style/TextAppearance.FastColoc.Body" />
    </LinearLayout>
    <TextView android:id="@+id/tvRecommendationReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="10dp" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnRecommendationDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recommendations_details" android:visibility="gone" style="@style/Widget.FastColoc.Button.Outlined" />
    <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnFavorite" app:icon="@drawable/ic_fc_heart" android:text="@string/s2_btnFavorite" android:minHeight="48dp" android:layout_marginTop="8dp" style="@style/Widget.FastColoc.Button.Outlined" />
</LinearLayout>