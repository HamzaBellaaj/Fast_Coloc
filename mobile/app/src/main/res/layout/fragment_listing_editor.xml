<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_editor_title" android:textAppearance="@style/TextAppearance.FastColoc.Title" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvStep" android:text="@string/s2_tvStep" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvState" android:text="@string/s2_tvState" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/sectionPresentation">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_spKind" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <Spinner android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/spKind" android:minHeight="50dp" android:contentDescription="@string/s2_hint_spKind"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etListingTitle" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etListingTitle" android:hint="@string/s2_hint_etListingTitle" android:inputType="text" android:maxLength="160" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etListingDescription" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etListingDescription" android:hint="@string/s2_hint_etListingDescription" android:inputType="textMultiLine" android:maxLength="10000" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etPropertyType" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etPropertyType" android:hint="@string/s2_hint_etPropertyType" android:inputType="text" android:maxLength="80" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etRoommateType" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etRoommateType" android:hint="@string/s2_hint_etRoommateType" android:inputType="text" android:maxLength="80" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/sectionLocation" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_spListingLocality" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <Spinner android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/spListingLocality" android:minHeight="50dp" android:contentDescription="@string/s2_hint_spListingLocality"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etStreet" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etStreet" android:hint="@string/s2_hint_etStreet" android:inputType="text" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etLatitude" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etLatitude" android:hint="@string/s2_hint_etLatitude" android:inputType="numberDecimal|numberSigned" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etLongitude" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etLongitude" android:hint="@string/s2_hint_etLongitude" android:inputType="numberDecimal|numberSigned" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/sectionConditions" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etRent" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etRent" android:hint="@string/s2_hint_etRent" android:inputType="numberDecimal" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etCapacity" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etCapacity" android:hint="@string/s2_hint_etCapacity" android:inputType="number" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etEquipment" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etEquipment" android:hint="@string/s2_hint_etEquipment" android:inputType="text" android:maxLength="2400" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etAvailableFrom" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etAvailableFrom" android:hint="@string/s2_hint_etAvailableFrom" android:inputType="date" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etAvailableUntil" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etAvailableUntil" android:hint="@string/s2_hint_etAvailableUntil" android:inputType="date" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etPublicationDays" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etPublicationDays" android:hint="@string/s2_hint_etPublicationDays" android:inputType="number" android:maxLength="250" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnBackStep" android:text="@string/s2_btnBackStep" android:minHeight="48dp" android:layout_marginTop="8dp" style="@style/Widget.FastColoc.Button"/>
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnNextStep" android:text="@string/s2_btnNextStep" android:minHeight="48dp" android:layout_marginTop="8dp" style="@style/Widget.FastColoc.Button"/>
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnSaveListing" android:text="@string/s2_btnSaveListing" android:minHeight="48dp" android:layout_marginTop="8dp" style="@style/Widget.FastColoc.Button"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/sectionPhotos" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_gallery_title" android:textAppearance="@style/TextAppearance.FastColoc.Title" android:layout_marginTop="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_gallery_help" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPhotos" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:nestedScrollingEnabled="false"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s2_label_etPhotoCaption" android:textAppearance="@style/TextAppearance.FastColoc.Body" android:layout_marginTop="12dp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FastColoc.Field">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etPhotoCaption" android:hint="@string/s2_hint_etPhotoCaption" android:inputType="text" android:maxLength="500" android:minHeight="50dp" android:saveEnabled="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnAddListingPhoto" android:text="@string/s2_btnAddListingPhoto" android:minHeight="48dp" android:layout_marginTop="8dp" style="@style/Widget.FastColoc.Button"/>
            <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnPublishListing" android:text="@string/s2_btnPublishListing" android:minHeight="48dp" android:layout_marginTop="8dp" style="@style/Widget.FastColoc.Button"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
